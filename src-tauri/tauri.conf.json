{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "version": "0.1.0",
  "identifier": "com.productivity-os.notes",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["productivity-notes"] } }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notes",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 17
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
